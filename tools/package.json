{
    "name": "tarkovbot-streamdeck-tools",
    "version": "1.5.0.0",
    "description": "Escape from Tarkov tools for Elgato Stream Deck — Goons tracker, trader restocks, raid server info, and live map info.",
    "license": "MIT",
    "author": "TarkovBOT.eu",
    "type": "module",
    "scripts": {
        "build": "rollup -c",
        "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart eu.tarkovbot.tools\"",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@elgato/cli": "^1.8.1",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.3.0",
        "@tsconfig/node20": "^20.1.10",
        "@types/node": "^26.2.0",
        "rollup": "^4.62.4",
        "tslib": "^2.8.1",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@elgato/streamdeck": "^2.1.1",
        "@elgato/utils": "^0.6.0"
    }
}
